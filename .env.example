# ── Core ──────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://power2plant:power2plant@localhost:5432/power2plant"
POSTGRES_PASSWORD="power2plant"
# Postgres data directory. Dev: leave unset (defaults to ./data). Prod: set to volume path.
# VOLUME_DATA_DIR=/mnt/HC_Volume_105677979/power2plant/prod/data

# ── Auth ───────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET="change-me-in-production-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── SMTP ───────────────────────────────────────────────────────────────────────
# Required for email verification, password reset, and feedback digest.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=yourpassword
# SMTP_FROM=noreply@example.com

# ── Admin ──────────────────────────────────────────────────────────────────────
# ADMIN_EMAILS=you@example.com,other@example.com
# CRON_SECRET=change-me
# FEEDBACK_IP_SALT=change-me

# ── Research / LLM ─────────────────────────────────────────────────────────────
# OPENROUTER_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=perplexity/sonar-deep-research
# RESEARCH_LOW_BALANCE_USD=5
# TREFLE_TOKEN=your_trefle_token_here

# ── Payments — Stripe ──────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Payments — Mollie ──────────────────────────────────────────────────────────
# MOLLIE_API_KEY=test_...
# MOLLIE_REDIRECT_URL_BASE=https://yourapp.com

# ── Payments — Ko-fi ───────────────────────────────────────────────────────────
# NEXT_PUBLIC_KOFI_URL=https://ko-fi.com/yourpage
# KOFI_VERIFICATION_TOKEN=...   # from Ko-fi Webhooks settings page

# ── Invoice service ────────────────────────────────────────────────────────────
# Generates §14 UStG-compliant invoices after each top-up.
# Enable by uncommenting COMPOSE_PROFILES; leave section commented to disable.
# COMPOSE_PROFILES=invoice
# INVOICE_DB_PASSWORD=change-me
# INVOICE_SERVICE_URL=http://invoice-service:3000
# INVOICE_SERVICE_SECRET=change-me
# INVOICE_DEFAULT_VAT_RATE=19
# INVOICE_DATA_DIR=/mnt/HC_Volume_105677979/power2plant/prod/invoices  # host path for PDF storage; defaults to $VOLUME_DATA_DIR/invoices
# SELLER_NAME=Your Company GmbH
# SELLER_ADDRESS_STREET=Musterstraße 1
# SELLER_ADDRESS_CITY=Berlin
# SELLER_ADDRESS_ZIP=10115
# SELLER_STEUERNUMMER=12/345/67890   # or use SELLER_VAT_ID
# SELLER_VAT_ID=DE123456789          # required for EU B2B cross-border
# INVOICE_EMAIL_PROVIDER=resend      # resend | postmark | smtp
# INVOICE_EMAIL_FROM=invoices@example.com
# INVOICE_RESEND_API_KEY=re_...      # if using resend
# INVOICE_POSTMARK_API_KEY=...       # if using postmark
# INVOICE_SMTP_HOST=smtp.example.com # if using smtp; defaults to main SMTP_* values if unset
# INVOICE_SMTP_PORT=587
# INVOICE_SMTP_USER=user@example.com
# INVOICE_SMTP_PASS=yourpassword
