DATABASE_URL="postgresql://power2plant:power2plant@localhost:5432/power2plant"
POSTGRES_PASSWORD="power2plant"
TREFLE_TOKEN="your_trefle_token_here"
BETTER_AUTH_SECRET="change-me-in-production-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# SMTP — required for email verification, password reset, and feedback digest
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=yourpassword
# SMTP_FROM=noreply@example.com
# Stripe — private/logged-in research funding (credit top-ups). Both can be set simultaneously.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Ko-fi — public/anonymous research funding link shown alongside Stripe.
# NEXT_PUBLIC_KOFI_URL=https://ko-fi.com/yourpage
# Admin access — comma-separated emails that can access /admin
# ADMIN_EMAILS=you@example.com,other@example.com
# Cron auth secret — must match the token sent by the cron container
# CRON_SECRET=change-me
# Feedback IP hashing salt — prevents reversing rate-limit hashes
# FEEDBACK_IP_SALT=change-me
# Mollie — EU payment provider (mirrors Stripe for EU customers).
# MOLLIE_API_KEY=test_...
# MOLLIE_REDIRECT_URL_BASE=https://yourapp.com
# Research worker — LLM + balance monitoring.
# OPENROUTER_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=perplexity/sonar-deep-research
# RESEARCH_LOW_BALANCE_USD=5
# Postgres data directory. Dev: leave unset (defaults to ./data). Prod: set to volume path.
# VOLUME_DATA_DIR=/mnt/HC_Volume_105677979/power2plant/prod/data
