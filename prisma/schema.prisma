generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Crop {
  id                String              @id @default(cuid())
  botanicalName     String              @unique
  canonicalName     String?
  name              String
  slug              String              @unique
  isNitrogenFixer   Boolean             @default(false)
  isCommonCrop      Boolean             @default(false)
  commonNames       String[]            @default([])
  minTempC          Float?
  imageUrl          String?
  sources           CropSource[]
  plantings         Planting[]
  relationshipsA    CropRelationship[]  @relation("CropA")
  relationshipsB    CropRelationship[]  @relation("CropB")
  translations         CropTranslation[]
  enrichmentAttempts   CropEnrichmentAttempt[]
  botanicalSynonyms    BotanicalSynonym[]
  researchRequestsA    ResearchRequest[]              @relation("ResearchRequestCropA")
  researchRequestsB    ResearchRequest[]              @relation("ResearchRequestCropB")
  researchAttemptsA    RelationshipResearchAttempt[]  @relation("ResearchAttemptCropA")
  researchAttemptsB    RelationshipResearchAttempt[]  @relation("ResearchAttemptCropB")
  researchQueueA       ResearchQueue[]                @relation("ResearchQueueA")
  researchQueueB       ResearchQueue[]                @relation("ResearchQueueB")
  badgesCrop           UserBadge[]                    @relation("UserBadgeCrop")
  badgesCropA          UserBadge[]                    @relation("UserBadgeCropA")
  badgesCropB          UserBadge[]                    @relation("UserBadgeCropB")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([canonicalName])
}

model CropTranslation {
  id          String   @id @default(cuid())
  cropId      String
  locale      String
  commonNames String[]
  crop        Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@unique([cropId, locale])
  @@index([locale])
}

model CropEnrichmentAttempt {
  id          String   @id @default(cuid())
  cropId      String
  locale      String
  source      String
  version     Int      @default(1)
  attemptedAt DateTime @default(now())
  crop        Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@unique([cropId, locale, source])
  @@index([locale, source])
}

model BotanicalSynonym {
  id     String @id @default(cuid())
  cropId String
  name   String
  source String
  crop   Crop   @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@unique([cropId, name])
  @@index([name])
}

model CropSource {
  id         String     @id @default(cuid())
  source     SourceType
  externalId String?
  url        String?
  rawData    Json
  fetchedAt  DateTime   @default(now())
  cropId     String
  crop       Crop       @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@unique([cropId, source])
}

model CropRelationship {
  id         String               @id @default(cuid())
  type       RelationshipType
  direction  Direction            @default(MUTUAL)
  reason     RelationshipReason?
  confidence Float                @default(0.5)
  notes      String?
  cropAId    String
  cropBId    String
  cropA      Crop                 @relation("CropA", fields: [cropAId], references: [id], onDelete: Cascade)
  cropB      Crop                 @relation("CropB", fields: [cropBId], references: [id], onDelete: Cascade)
  sources    RelationshipSource[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([cropAId, cropBId])
  @@index([cropBId])
}

model RelationshipSource {
  id              String                @id @default(cuid())
  source          SourceType
  sourceType      SourceClassification?
  confidence      ConfidenceLevel       @default(ANECDOTAL)
  position        RelationshipType?
  reason          RelationshipReason?
  sourceDirection Direction?
  url             String?
  notes           String?
  fetchedAt       DateTime              @default(now())
  relationshipId  String
  relationship    CropRelationship      @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  userId          String?
  checks          SourceCheck[]

  @@index([relationshipId])
  @@index([userId])
}

model SourceCheck {
  id        String             @id @default(cuid())
  sourceId  String
  source    RelationshipSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  checkedBy String
  checkedAt DateTime           @default(now())
  correct   Boolean
  notes     String?

  @@index([sourceId])
}

model UserGarden {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lat         Float?
  lng         Float?
  minTempC    Float?
  bedCount    Int      @default(3)
  bedCapacity Int      @default(3)
  wishlist     String[] @default([])
  inspirations String[] @default([])
  beds         Bed[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Bed {
  id        String     @id @default(cuid())
  name      String
  gardenId  String
  garden    UserGarden @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  plantings Planting[]

  @@index([gardenId])
}

enum PlantingStatus {
  PLANNED
  PLANTED
  HARVESTED
}

model Planting {
  id     String         @id @default(cuid())
  bedId  String
  bed    Bed            @relation(fields: [bedId], references: [id], onDelete: Cascade)
  cropId String
  crop   Crop           @relation(fields: [cropId], references: [id], onDelete: Restrict)
  status PlantingStatus @default(PLANNED)

  @@index([bedId])
  @@index([cropId])
}

enum RelationshipType {
  COMPANION
  AVOID
  NEUTRAL
  ATTRACTS
  REPELS
  NURSE
  TRAP_CROP
}

enum Direction {
  MUTUAL
  ONE_WAY
  UNKNOWN
}

enum RelationshipReason {
  PEST_CONTROL
  POLLINATION
  NUTRIENT
  SHADE
  ALLELOPATHY
  OTHER
}

enum ConfidenceLevel {
  ANECDOTAL
  TRADITIONAL
  OBSERVED
  PEER_REVIEWED
}

enum SourceType {
  TREFLE
  USDA
  OPENFARM_DUMP
  PLANTBUDDIES
  PFAF
  WIKIDATA
  GBIF
  COMMUNITY
  MANUAL
  RESEARCH
}

enum SourceClassification {
  SCIENTIFIC_PAPER
  ACADEMIC_RESOURCE
  GARDENING_GUIDE
  BLOG_FORUM
  PERSONAL_OBSERVATION
}

model user {
  id                  String                @id @default(cuid())
  name                String
  email               String                @unique
  emailVerified       Boolean               @default(false)
  image               String?
  trustScore          Float                 @default(1.0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  sessions            session[]
  accounts            account[]
  garden              UserGarden?
  gardenShares        GardenShare[]
  researchVotes       ResearchRequestVote[]
  credit              UserCredit?
  creditTransactions  CreditTransaction[]
  researchFunding     ResearchFunder[]
  badges              UserBadge[]
  feedbackVotes       FeedbackVote[]
  feedbackComments    FeedbackComment[]
}

model GardenShare {
  token     String   @id
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  beds      Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([accountId, providerId])
}

model verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

enum FeedbackMode {
  DATA
  OTHER
}

enum FeedbackStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Feedback {
  id           String         @id @default(cuid())
  mode         FeedbackMode
  pageUrl      String
  entityType   String?
  entityId     String?
  targetKey    String?
  screenshot   String?
  annotation   Json?
  message      String
  ipHash       String
  status       FeedbackStatus @default(OPEN)
  createdAt    DateTime       @default(now())
  resolvedAt   DateTime?
  resolvedNote String?

  @@index([status, createdAt])
  @@index([ipHash, createdAt])
  votes    FeedbackVote[]
  comments FeedbackComment[]
}

model AppConfig {
  id                     String   @id @default("singleton")
  feedbackDigestEnabled  Boolean  @default(false)
  feedbackDigestFreq     String   @default("daily")
  feedbackDigestEmails   String[] @default([])
}

enum ResearchAttemptResult {
  NOT_FOUND
  LOW_CONFIDENCE
}

model RelationshipResearchAttempt {
  id          String                @id @default(cuid())
  cropAId     String
  cropBId     String
  model       String
  result      ResearchAttemptResult
  confidence  Float?
  notes       String?
  attemptedAt DateTime              @default(now())
  cropA       Crop                  @relation("ResearchAttemptCropA", fields: [cropAId], references: [id], onDelete: Cascade)
  cropB       Crop                  @relation("ResearchAttemptCropB", fields: [cropBId], references: [id], onDelete: Cascade)

  @@unique([cropAId, cropBId, model])
  @@index([cropAId, cropBId])
}

model ResearchRequest {
  id        String                @id @default(cuid())
  cropAId   String
  cropBId   String?
  voteCount Int                   @default(0)
  funded    Boolean               @default(false)
  createdAt DateTime              @default(now())
  cropA     Crop                  @relation("ResearchRequestCropA", fields: [cropAId], references: [id], onDelete: Cascade)
  cropB     Crop?                 @relation("ResearchRequestCropB", fields: [cropBId], references: [id], onDelete: Cascade)
  votes     ResearchRequestVote[]

  // Uniqueness enforced by partial indexes in migration (Prisma can't express partial unique)
  @@index([cropAId, cropBId])
  @@index([voteCount])
  @@index([funded])
}

model ResearchRequestVote {
  id        String          @id @default(cuid())
  requestId String
  userId    String
  createdAt DateTime        @default(now())
  request   ResearchRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      user            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
  @@index([userId])
}

// ─── Enums: Research Funding System ──────────────────────────────────────────

enum CreditTransactionType {
  TOP_UP
  SPEND
  REFUND
}

enum ResearchQueueStatus {
  PENDING
  IN_PROGRESS
  DONE
  FAILED
}

enum ResearchTrigger {
  PERSONAL
  POT
  ADMIN
}

enum FundingSource {
  PERSONAL
  POT
}

enum PotTransactionType {
  DONATION
  SPEND
}

enum BadgeType {
  INCREMENTAL
  PLANT
  PAIR
}

enum FeedbackVoteType {
  AGREE
  DISAGREE
}

// ─── Credit System ────────────────────────────────────────────────────────────

model UserCredit {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceCents Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model CreditTransaction {
  id                    String                @id @default(cuid())
  userId                String
  user                  user                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                  CreditTransactionType
  amountCents           Int                   // positive = add, negative = deduct
  description           String?
  researchQueueId       String?
  researchQueue         ResearchQueue?        @relation(fields: [researchQueueId], references: [id])
  stripePaymentIntentId String?
  molliePaymentId       String?
  createdAt             DateTime              @default(now())

  @@index([userId])
  @@index([researchQueueId])
}

// ─── Research Execution Queue & Log ──────────────────────────────────────────

// ResearchRequest (existing) = vote/demand queue
// ResearchQueue (new)        = funded execution queue, FIFO on createdAt

model ResearchQueue {
  id          String              @id @default(cuid())
  cropAId     String              // always < cropBId lexicographically (app-enforced)
  cropA       Crop                @relation("ResearchQueueA", fields: [cropAId], references: [id])
  cropBId     String
  cropB       Crop                @relation("ResearchQueueB", fields: [cropBId], references: [id])
  status      ResearchQueueStatus @default(PENDING)
  triggeredBy ResearchTrigger
  priceCents  Int
  createdAt   DateTime            @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  funders            ResearchFunder[]
  log                ResearchLog?
  creditTransactions CreditTransaction[]
  potTransactions    PotTransaction[]

  @@unique([cropAId, cropBId])
  @@index([status, createdAt])
}

model ResearchLog {
  id               String        @id @default(cuid())
  researchQueueId  String        @unique
  researchQueue    ResearchQueue @relation(fields: [researchQueueId], references: [id])
  model            String
  promptTokens     Int
  completionTokens Int
  costUsd          Decimal       @db.Decimal(10, 6)
  requestJson      Json
  responseJson     Json
  createdAt        DateTime      @default(now())
}

// Stores historical prices; current price = latest effectiveFrom <= now()
model ResearchPrice {
  id                    String   @id @default(cuid())
  pricePerResearchCents Int
  effectiveFrom         DateTime @default(now())
  notes                 String?

  @@index([effectiveFrom])
}

// ─── Community Pot ────────────────────────────────────────────────────────────
// Pot balance = SUM(amountCents WHERE type=DONATION) - SUM(amountCents WHERE type=SPEND)

model PotTransaction {
  id                String             @id @default(cuid())
  type              PotTransactionType
  amountCents       Int
  currency          String             @default("EUR")
  kofiTransactionId String?            @unique
  molliePaymentId   String?            @unique
  researchQueueId   String?
  researchQueue     ResearchQueue?     @relation(fields: [researchQueueId], references: [id])
  createdAt         DateTime           @default(now())

  @@index([type])
  @@index([createdAt])
}

// ─── Research Funders (shown on companion/plant pages) ────────────────────────

model ResearchFunder {
  id              String        @id @default(cuid())
  researchQueueId String
  researchQueue   ResearchQueue @relation(fields: [researchQueueId], references: [id])
  userId          String?       // null = community/pot funder
  user            user?         @relation(fields: [userId], references: [id])
  source          FundingSource
  createdAt       DateTime      @default(now())

  @@index([researchQueueId])
  @@index([userId])
}

// ─── Badges ───────────────────────────────────────────────────────────────────

model UserBadge {
  id        String    @id @default(cuid())
  userId    String
  user      user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      BadgeType
  // slug encodes uniqueness: "INCREMENTAL:10" | "PLANT:<cropId>" | "PAIR:<cropAId>:<cropBId>"
  slug      String
  tier      Int?      // INCREMENTAL only: 1, 10, 30, 50, 100
  cropId    String?   // PLANT only
  crop      Crop?     @relation("UserBadgeCrop",  fields: [cropId],  references: [id])
  cropAId   String?   // PAIR only (always < cropBId)
  cropA     Crop?     @relation("UserBadgeCropA", fields: [cropAId], references: [id])
  cropBId   String?   // PAIR only
  cropB     Crop?     @relation("UserBadgeCropB", fields: [cropBId], references: [id])
  awardedAt DateTime  @default(now())

  @@unique([userId, slug])
  @@index([userId, type])
}

// ─── Community Feedback Extensions ───────────────────────────────────────────

model FeedbackVote {
  id         String           @id @default(cuid())
  feedbackId String
  feedback   Feedback         @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  userId     String
  user       user             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vote       FeedbackVoteType
  createdAt  DateTime         @default(now())

  @@unique([feedbackId, userId])
  @@index([feedbackId])
}

model FeedbackComment {
  id         String            @id @default(cuid())
  feedbackId String
  feedback   Feedback          @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  userId     String
  user       user              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     FeedbackComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies    FeedbackComment[] @relation("CommentReplies")
  body       String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([feedbackId])
  @@index([parentId])
}
