[
  {
    "id": "deploy-prod",
    "execute-command": "/bin/sh",
    "pass-arguments-to-command": [
      { "source": "string", "name": "-c" },
      { "source": "string", "name": "touch /run/p2p/deploy.trigger" }
    ],
    "response-message": "Deploy queued.",
    "trigger-rule": {
      "and": [
        {
          "match": {
            "type": "payload-hmac-sha256",
            "secret": "__WEBHOOK_SECRET__",
            "parameter": { "source": "header", "name": "X-Hub-Signature-256" }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "release",
            "parameter": { "source": "header", "name": "X-GitHub-Event" }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "published",
            "parameter": { "source": "payload", "name": "action" }
          }
        }
      ]
    }
  },
  {
    "id": "deploy-staging",
    "execute-command": "/bin/sh",
    "pass-arguments-to-command": [
      { "source": "string", "name": "-c" },
      { "source": "string", "name": "printf '%s' \"$1\" > /run/p2p/staging-deploy.branch && touch /run/p2p/staging-deploy.trigger" },
      { "source": "string", "name": "--" },
      { "source": "payload", "name": "workflow_run.head_branch" }
    ],
    "response-message": "Staging deploy queued.",
    "trigger-rule": {
      "and": [
        {
          "match": {
            "type": "payload-hmac-sha256",
            "secret": "__STAGING_WEBHOOK_SECRET__",
            "parameter": { "source": "header", "name": "X-Hub-Signature-256" }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "workflow_run",
            "parameter": { "source": "header", "name": "X-GitHub-Event" }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "completed",
            "parameter": { "source": "payload", "name": "action" }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "success",
            "parameter": { "source": "payload", "name": "workflow_run.conclusion" }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "DB Integrity",
            "parameter": { "source": "payload", "name": "workflow_run.name" }
          }
        },
        {
          "match": {
            "type": "regex",
            "regex": "^release/",
            "parameter": { "source": "payload", "name": "workflow_run.head_branch" }
          }
        }
      ]
    }
  }
]
